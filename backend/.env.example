# "mock" needs no LLM and returns the best matching content as the answer.
LLM_PROVIDER=mock

# For a real model, set LLM_PROVIDER=openai and point at any
# OpenAI-compatible endpoint. Example below is a local Ollama server.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=none
# LLM_MODEL=<model name as your provider lists it>

MONTHLY_MESSAGE_CAP=1000
MIN_SCORE=0.3
DB_PATH=faqbot.db
CORS_ORIGINS=http://localhost:5173

# Signs owner login tokens. Required when deploying; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Chat messages allowed per visitor every 10 minutes.
CHAT_LIMIT=20
# Set to 1 only when the app sits behind a reverse proxy you control.
# TRUST_PROXY=1
